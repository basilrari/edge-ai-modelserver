# Drone_LLM model server (copy to .env or source from run.sh)
GATEWAY_URL=http://127.0.0.1:3000
MODEL_SERVER_PORT=8000

# Live camera for WebRTC (/camera/webrtc/offer)
# v4l2 = local USB camera (default)
# gopro = GoPro USB preview via drone-competition/perception (see below)
CAMERA_BACKEND=v4l2
# Path to drone-competition/perception when using CAMERA_BACKEND=gopro
DRONE_PERCEPTION_PATH=../drone-competition/perception

# Optional TURN for remote viewers (see deploy/coturn/README.md)
# WEBRTC_PUBLIC_HOST=<jetson-public-ip>
# WEBRTC_TURN_USERNAME=webrtc
# WEBRTC_TURN_PASSWORD=<from configure-coturn.sh>

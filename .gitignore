# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
ayush/

# Dashboard offline uploads + per-video export folders
uploads/

# Benchmark source videos (large — download separately)
benchmarks/videos/
benchmarks/results/videos/

# Benchmark overlay MP4s (keep CSV/plots/HTML in dashboard/)
**/*_overlay.mp4

# Training datasets (large — download separately)
models/flood_classifier/dataset/
models/flood_segmentation/**/dataset/
models/flood_segmentation/**/JPEGImages/
models/flood_segmentation/**/SegmentationClass/
models/flood_segmentation/**/SegmentationObject/
models/flood_segmentation/**/ImageSets/

# Model weights and build artifacts (large, machine-specific — keep local only).
# TensorRT engines are bound to the local TensorRT/CUDA build, so a committed
# engine goes stale after a version bump; re-export with tools/export_tensorrt.py
# rather than tracking them.
*.engine
*.onnx
*.pt
*.pth

# IDE / OS
.idea/
.vscode/
.DS_Store
*.Zone.Identifier

# Local environment (per-machine paths, camera serial; see .env.example if present)
.env
.env.local

# Ad-hoc runtime frame captures (not benchmark artifacts)
logs/human_detect_last.jpg
